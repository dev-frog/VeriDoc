# --- MongoDB Atlas (8.1+) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=veridoc

# --- Embeddings ---
# EMBED_PROVIDER: openai-compatible (any OpenAI-style /embeddings API) | voyage
# Examples for EMBED_BASE_URL:
#   OpenRouter:   https://openrouter.ai/api/v1
#   OpenAI:       https://api.openai.com/v1
#   Azure OpenAI: https://<resource>.openai.azure.com/openai/v1  (EMBED_MODEL = deployment name)
EMBED_PROVIDER=openai-compatible
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBED_DIMENSIONS=2048

# --- Reranker: cohere | voyage | jina | none ---
# RERANK_MODEL empty = provider default (cohere: rerank-v3.5, voyage: rerank-2.5, jina: jina-reranker-v2-base-multilingual)
RERANK_PROVIDER=none
RERANK_API_KEY=
RERANK_MODEL=

# --- LLM: any OpenAI-compatible /chat/completions API ---
#   OpenRouter: https://openrouter.ai/api/v1   OpenAI: https://api.openai.com/v1
#   Azure OpenAI: https://<resource>.openai.azure.com/openai/v1 (LLM_MODEL = deployment name)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=            # e.g. openrouter/free, openai/gpt-4o-mini, or an Azure deployment name

# --- App ---
# Request logs: pretty | json | off (default: pretty locally, json when NODE_ENV=production)
LOG_FORMAT=
VERIDOC_API_KEY=change-me
BLOB_READ_WRITE_TOKEN=

# --- Retrieval tuning ---
CHUNK_TOKENS=600
CHUNK_OVERLAP=0.12
TOP_K=30
TOP_N=5

# --- Ingestion ---
# Hosts POST /documents may download from (comma-separated; "*" = any https host)
SOURCE_URL_HOSTS=*.public.blob.vercel-storage.com
MAX_FILE_MB=50
INGEST_BATCH_SIZE=256
EMBED_BATCH_SIZE=256

# Local dev only
PORT=3000
