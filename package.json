{
  "name": "veridoc",
  "version": "0.1.0",
  "description": "Open-source RAG engine. Every answer, traced to its source.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.10"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node --env-file=.env scripts/check.js",
    "db:setup": "node --env-file=.env scripts/setup-indexes.js",
    "ingest": "node --env-file=.env scripts/ingest-cli.js",
    "veridoc": "node scripts/veridoc.js",
    "eval": "node --env-file=.env scripts/eval.js",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@vercel/blob": "^2.9.0",
    "hono": "^4.13.17",
    "js-tiktoken": "^1.0.21",
    "mammoth": "^1.13.0",
    "mongodb": "^7.8.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "bin": {
    "veridoc": "scripts/veridoc.js"
  }
}
